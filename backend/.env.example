FLASK_ENV=development
SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-a-different-long-random-secret
DATABASE_URL=postgresql+psycopg://mediflow:mediflow@localhost:5432/mediflow
CORS_ORIGINS=http://localhost:5173

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

JWT_ACCESS_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
STAFF_INACTIVITY_MINUTES=15
PASSWORD_RESET_TTL_MINUTES=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./instance/storage
STORAGE_BUCKET=mediflow-documents
STORAGE_SIGNED_URL_TTL_SECONDS=300

MPESA_MODE=simulated
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
MPESA_CALLBACK_SECRET=


SHA_MODE=simulated
SHA_BASE_URL=
SHA_API_KEY=

MESSAGING_MODE=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=no-reply@mediflow.local

LLM_MODE=deterministic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

APPOINTMENT_CANCELLATION_CUTOFF_HOURS=2
CLAIM_AGING_DAYS=14,30,60
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
